{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TaskCalendar+",
  "version": "0.1.3",
  "identifier": "io.github.t-ueda21.taskcalendarplus",
  "build": {
    "frontendDist": "renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "TaskCalendar+",
        "width": 1280,
        "height": 800,
        "url": "about:blank",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": [
      "renderer/**/*"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENFRjc4ODg0RUYxQUUyQzcKUldUSDRocnZoSWozempYdFp3ZmwvKzhwMjFmaUxDL2s2UGpLZWZkY0NOUzBjcEZmWUc1dWxrQVQK",
      "endpoints": [
        "https://github.com/t-ueda21/TaskCalendar-Plus/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
